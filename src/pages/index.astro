---
import Layout from '../layouts/Layout.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { Image } from 'astro:assets';
import perfilImg from '../assets/foto.png';

const data = {
	name: "Franco Barrionuevo",
	title: "IT Support & Automation Engineer",
	location: "Carapachay, Buenos Aires, AR",
	phone: "+54 9 381 574-4776",
	phoneTel: "+5493815744776",
	email: "franmaxii@hotmail.com",
	web: "franmaxi.dev",
	webUrl: "https://franmaxi.dev",
	github: "github.com/franmaxii",
	githubUrl: "https://github.com/franmaxii",
	linkedin: "linkedin.com/in/franco-maximiliano-barrionuevo",
	linkedinUrl: "https://www.linkedin.com/in/franco-maximiliano-barrionuevo/"
};
---

<Layout title={`${data.name} | Portfolio IT`}>
	<FloatingContact />
	
	<!-- NAV: Sticky Glassmorphism -->
	<nav class="no-print fixed w-full z-50 bg-[#060B14]/70 backdrop-blur-xl border-b border-white/5 transition-all">
		<div class="max-w-6xl mx-auto px-8 py-4 flex justify-between items-center">
			<span class="font-display text-blue-500 font-black text-xl tracking-tighter drop-shadow-[0_0_8px_rgba(59,130,246,0.5)]">FB.</span>
			<div class="hidden md:flex items-center gap-8">
				<a href="#perfil" class="nav-link">Perfil</a>
				<a href="#trayectoria" class="nav-link">Experiencia</a>
				<a href="#competencias" class="nav-link">Skills Tech</a>
				<a href="#formacion" class="nav-link">Educación</a>
			</div>
		</div>
	</nav>

	<main class="max-w-6xl mx-auto px-8 pt-10 text-slate-300 print:text-black print:p-0 print:m-0 print:max-w-none">

		<!-- HERO SECTION -->
		<header id="perfil" class="relative pt-36 pb-20 print:pt-0 print:pb-4 print:border-b-2 print:border-black">
			
			<!-- Fondo Glow Tech -->
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-blue-600/10 blur-[120px] rounded-full pointer-events-none no-print"></div>
			<div class="absolute -top-20 right-0 w-[400px] h-[400px] bg-cyan-500/10 blur-[100px] rounded-full pointer-events-none no-print"></div>

			<div class="flex flex-col md:flex-row items-start gap-10 print:flex-row print:gap-6 relative z-10">
				<!-- FOTO -->
				<div class="flex-shrink-0 relative group">
					<div class="absolute inset-0 bg-blue-500 rounded-full blur-md opacity-30 group-hover:opacity-60 transition duration-500 no-print"></div>
					<div class="relative w-36 h-36 md:w-44 md:h-44 rounded-full overflow-hidden border-2 border-white/10 shadow-[0_0_30px_rgba(59,130,246,0.15)] group-hover:border-blue-500/50 transition-colors print:border-slate-300 print:shadow-none print:w-28 print:h-28">
						<Image src={perfilImg} alt={data.name} class="w-full h-full object-cover" />
					</div>
				</div>
				
				<!-- TEXTO HERO -->
				<div class="flex-1 print:mt-2">
					<div class="fade-up inline-flex items-center gap-2 border border-blue-500/20 rounded-full px-4 py-1.5 mb-6 text-xs font-semibold uppercase tracking-widest text-blue-400 bg-blue-900/20 backdrop-blur-md print:hidden">
						<span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse shadow-[0_0_8px_#60A5FA]"></span>
						IT & AI Automation
					</div>
					<h1 class="fade-up font-display text-5xl md:text-7xl font-black text-white leading-none tracking-tight mb-2 print:text-3xl print:text-black">
						Franco <em class="text-blue-500 not-italic print:text-black">Barrionuevo</em>
					</h1>
					<div class="ornament-divider fade-up no-print" aria-hidden="true"><span></span><em class="text-blue-500 text-xl">⚡</em><span style="background:linear-gradient(to left,var(--primary),transparent);"></span></div>
					<h2 class="fade-up text-base font-bold text-cyan-400 uppercase tracking-[0.2em] mb-6 print:text-slate-800 print:text-[11pt] print:mt-1 print:mb-3">
						{data.title}
					</h2>
					<p class="fade-up text-sm leading-relaxed text-slate-400 max-w-2xl mb-8 print:text-black print:text-[10pt] print:mb-3">
						Profesional especializado en el <strong>Soporte de Infraestructura IT (Troubleshooting N1/N2)</strong> y la <strong>Automatización Inteligente de Procesos</strong>. Combino la administración de sistemas (Linux/Win, Servidores, GLPI) con el desarrollo de soluciones lógicas mediante <strong>n8n, Python y Agentes de IA</strong>. Mi enfoque es modernizar operaciones: reducir tareas manuales repetitivas, asegurar la red y resolver incidentes bajo SLAs corporativos exigentes.
					</p>
					
					<!-- DATOS CONTACTO -->
					<div class="fade-up flex flex-wrap gap-3 text-sm font-medium print:gap-1 print:flex-col print:text-[9.5pt]">
						<div class="flex gap-3 print:gap-6 print:mb-1">
							<a href={`mailto:${data.email}`} class="flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/5 rounded-md hover:bg-white/10 transition-all text-slate-300 print:text-black print:bg-transparent print:border-0 print:p-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 print:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>{data.email}
							</a>
							<a href={`tel:${data.phoneTel}`} class="flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/5 rounded-md hover:bg-white/10 transition-all text-slate-300 print:text-black print:bg-transparent print:border-0 print:p-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 print:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>{data.phone}
							</a>
							<span class="flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/5 rounded-md text-slate-300 print:text-black print:bg-transparent print:border-0 print:p-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 print:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>{data.location}
							</span>
						</div>
						
						<!-- ATS KEYWORDS IN PRINT: URLs explicitly written out for ATS parsers -->
						<div class="hidden print:flex flex-col gap-1 mt-1 text-[9pt] text-slate-700 font-medium">
							<span><strong>LinkedIn:</strong> {data.linkedin}</span>
							<span><strong>GitHub:</strong> {data.github}</span>
							<span><strong>Portfolio:</strong> {data.web}</span>
						</div>
					</div>
				</div>
			</div>
		</header>

		<!-- MÉTRICAS TECH -->
		<section class="fade-up py-10 print:hidden">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				<div class="p-6 rounded-xl bg-[#0F172A]/80 border border-slate-800 shadow-inner backdrop-blur-md">
					<p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-1">Automatización</p>
					<p class="font-display text-3xl font-black text-blue-400">n8n / IA</p>
				</div>
				<div class="p-6 rounded-xl bg-[#0F172A]/80 border border-slate-800 shadow-inner backdrop-blur-md">
					<p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-1">Tickets / Gestión</p>
					<p class="font-display text-3xl font-black text-cyan-400">GLPI</p>
				</div>
				<div class="p-6 rounded-xl bg-[#0F172A]/80 border border-slate-800 shadow-inner backdrop-blur-md">
					<p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-1">Conexión Remota</p>
					<p class="font-display text-3xl font-black text-indigo-400">SSH / Putty</p>
				</div>
				<div class="p-6 rounded-xl bg-[#0F172A]/80 border border-slate-800 shadow-inner backdrop-blur-md">
					<p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-1">Lenguajes</p>
					<p class="font-display text-3xl font-black text-blue-500">Python</p>
				</div>
			</div>
		</section>

		<!-- EXPERIENCIA LABORAL -->
		<section id="trayectoria" class="py-14 print:py-4 print:border-0">
			<div class="fade-up mb-10 print:mb-3">
				<p class="text-xs font-bold uppercase tracking-[0.25em] text-blue-500 mb-2 no-print">Trayectoria Profesional</p>
				<h2 class="font-display text-3xl md:text-4xl font-bold text-white print:text-[14pt] print:border-b print:border-black print:pb-1 print:text-black uppercase">Experiencia Laboral</h2>
			</div>
			
			<div class="space-y-6 print:space-y-4">
				
				<!-- Exp 1 -->
				<div class="fade-up exp-card rounded-2xl p-6 md:p-8 bg-[#0F172A]/50 border border-white/5 pl-10 relative backdrop-blur-sm print:bg-transparent print:border-0 print:p-0 print:pl-4 print:border-l-2 print:border-slate-400">
					<div class="absolute left-0 top-0 bottom-0 w-1 rounded-l-2xl bg-gradient-to-b from-blue-500 to-transparent no-print"></div>
					<div class="flex flex-wrap justify-between items-start gap-4 mb-3">
						<div>
							<h3 class="font-display text-xl font-bold text-white print:text-[11.5pt] print:text-black">Técnico de Sistemas & Infraestructura IT</h3>
							<p class="text-blue-400 font-semibold text-sm mt-0.5 italic print:text-slate-700">Empresa de Recupero Crediticio</p>
						</div>
						<span class="bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-md print:bg-transparent print:border-0 print:text-slate-800 print:p-0">Sept 2025 — Actualidad</span>
					</div>
					<ul class="space-y-2 text-sm text-slate-300 leading-relaxed print:text-[9.5pt] print:text-black print:space-y-1">
						<li class="flex gap-3"><span class="text-blue-500 flex-shrink-0 print:text-black">▸</span><span><strong>Soporte Técnico N2 & Help Desk:</strong> Resolución de incidencias corporativas, diagnóstico de hardware/software y gestión de usuarios en plataformas de tickets (GLPI).</span></li>
						<li class="flex gap-3"><span class="text-blue-500 flex-shrink-0 print:text-black">▸</span><span><strong>Administración de Redes y Servidores:</strong> Configuración de conexiones seguras (SSH mediante Putty), mantenimiento de la red local y asignación de permisos.</span></li>
						<li class="flex gap-3"><span class="text-blue-500 flex-shrink-0 print:text-black">▸</span><span><strong>Infraestructura & Hardware:</strong> Ensamblaje, reparación, mantenimiento preventivo de PC y configuración de entornos de booteo (Dual-boot, BIOS/UEFI).</span></li>
					</ul>
				</div>

				<!-- Exp 2 -->
				<div class="fade-up exp-card rounded-2xl p-6 md:p-8 bg-[#0F172A]/50 border border-white/5 pl-10 relative backdrop-blur-sm print:bg-transparent print:border-0 print:p-0 print:pl-4 print:border-l-2 print:border-slate-400">
					<div class="absolute left-0 top-0 bottom-0 w-1 rounded-l-2xl bg-gradient-to-b from-cyan-500 to-transparent no-print"></div>
					<div class="flex flex-wrap justify-between items-start gap-4 mb-3">
						<div>
							<h3 class="font-display text-xl font-bold text-white print:text-[11.5pt] print:text-black">Automation Engineer & IA</h3>
							<p class="text-cyan-400 font-semibold text-sm mt-0.5 italic print:text-slate-700">Proyectos de Innovación Tecnológica</p>
						</div>
						<span class="bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-md print:bg-transparent print:border-0 print:text-slate-800 print:p-0">Ene 2026 — Actualidad</span>
					</div>
					<ul class="space-y-2 text-sm text-slate-300 leading-relaxed print:text-[9.5pt] print:text-black print:space-y-1">
						<li class="flex gap-3"><span class="text-cyan-500 flex-shrink-0 print:text-black">▸</span><span><strong>Desarrollo de Automatizaciones (n8n):</strong> Creación de flujos de trabajo (workflows) conectando APIs para optimizar procesos repetitivos y sincronizar datos empresariales.</span></li>
						<li class="flex gap-3"><span class="text-cyan-500 flex-shrink-0 print:text-black">▸</span><span><strong>Agentes de Inteligencia Artificial & Python:</strong> Integración de modelos de lenguaje (LLMs) y scripts en Python para potenciar bots de atención (Franmaxi-IA).</span></li>
						<li class="flex gap-3"><span class="text-cyan-500 flex-shrink-0 print:text-black">▸</span><span><strong>Bases de Datos & Hosting:</strong> Despliegue de bases de datos ágiles (PocketBase/SQLite) y administración de paneles de hosting (Ferozo).</span></li>
					</ul>
				</div>

				<!-- Exp 3 -->
				<div class="fade-up exp-card rounded-2xl p-6 md:p-8 bg-[#0F172A]/50 border border-white/5 pl-10 relative backdrop-blur-sm print:bg-transparent print:border-0 print:p-0 print:pl-4 print:border-l-2 print:border-slate-400">
					<div class="absolute left-0 top-0 bottom-0 w-1 rounded-l-2xl bg-gradient-to-b from-slate-600 to-transparent no-print"></div>
					<div class="flex flex-wrap justify-between items-start gap-4 mb-3">
						<div>
							<h3 class="font-display text-xl font-bold text-white print:text-[11.5pt] print:text-black">Soporte Técnico (N1) & Customer Service</h3>
							<p class="text-slate-400 font-semibold text-sm mt-0.5 italic print:text-slate-700">Customer Aegis</p>
						</div>
						<span class="bg-slate-500/10 text-slate-400 border border-slate-500/20 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-md print:bg-transparent print:border-0 print:text-slate-800 print:p-0">Jun 2020 — Dic 2022</span>
					</div>
					<ul class="space-y-2 text-sm text-slate-300 leading-relaxed print:text-[9.5pt] print:text-black print:space-y-1">
						<li class="flex gap-3"><span class="text-slate-500 flex-shrink-0 print:text-black">▸</span><span><strong>Troubleshooting Remoto:</strong> Diagnóstico, triaje y resolución ágil de problemas reportados por usuarios finales.</span></li>
						<li class="flex gap-3"><span class="text-slate-500 flex-shrink-0 print:text-black">▸</span><span><strong>Software CRM & SLAs:</strong> Actualización y seguimiento de incidencias en sistemas CRM, superando métricas de satisfacción (CSAT) y resolución.</span></li>
					</ul>
				</div>
			</div>
		</section>

		<!-- COMPETENCIAS TÉCNICAS -->
		<section id="competencias" class="py-14 print:py-4 print:border-0">
			<div class="fade-up mb-10 print:mb-3">
				<p class="text-xs font-bold uppercase tracking-[0.25em] text-cyan-400 mb-2 no-print">Stack Tecnológico</p>
				<h2 class="font-display text-3xl md:text-4xl font-bold text-white print:text-[14pt] print:border-b print:border-black print:pb-1 print:text-black uppercase">Skills Tech & Tools</h2>
			</div>
			
			<div class="fade-up grid md:grid-cols-2 gap-x-12 gap-y-7 mb-10 print:hidden">
				<div><div class="flex justify-between text-[11px] font-bold uppercase tracking-wider mb-2 text-slate-300"><span>Troubleshooting Hardware & PC</span><span class="text-blue-400">95%</span></div><div class="h-1 bg-slate-800 rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full bg-gradient-to-r from-blue-600 to-cyan-400 shadow-[0_0_10px_#60A5FA]" style="--target-width:95%"></div></div></div>
				<div><div class="flex justify-between text-[11px] font-bold uppercase tracking-wider mb-2 text-slate-300"><span>Linux Admin / Windows 11</span><span class="text-blue-400">90%</span></div><div class="h-1 bg-slate-800 rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full bg-gradient-to-r from-blue-600 to-cyan-400 shadow-[0_0_10px_#60A5FA]" style="--target-width:90%"></div></div></div>
				<div><div class="flex justify-between text-[11px] font-bold uppercase tracking-wider mb-2 text-slate-300"><span>n8n / Agentes Inteligencia Artificial</span><span class="text-blue-400">85%</span></div><div class="h-1 bg-slate-800 rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full bg-gradient-to-r from-blue-600 to-cyan-400 shadow-[0_0_10px_#60A5FA]" style="--target-width:85%"></div></div></div>
				<div><div class="flex justify-between text-[11px] font-bold uppercase tracking-wider mb-2 text-slate-300"><span>Python / Bash Scripting</span><span class="text-blue-400">75%</span></div><div class="h-1 bg-slate-800 rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full bg-gradient-to-r from-blue-600 to-cyan-400 shadow-[0_0_10px_#60A5FA]" style="--target-width:75%"></div></div></div>
				<div><div class="flex justify-between text-[11px] font-bold uppercase tracking-wider mb-2 text-slate-300"><span>Gestión TI (GLPI / Putty / Ferozo)</span><span class="text-blue-400">85%</span></div><div class="h-1 bg-slate-800 rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full bg-gradient-to-r from-blue-600 to-cyan-400 shadow-[0_0_10px_#60A5FA]" style="--target-width:85%"></div></div></div>
				<div><div class="flex justify-between text-[11px] font-bold uppercase tracking-wider mb-2 text-slate-300"><span>Inglés (Lectura Técnica / IT)</span><span class="text-blue-400">Básico/Técnico</span></div><div class="h-1 bg-slate-800 rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full bg-slate-500" style="--target-width:50%"></div></div></div>
			</div>

			<div class="fade-up mb-6 print:mb-2">
				<p class="text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-3 print:text-black print:text-[10pt] print:mb-1 border-l-2 border-slate-700 pl-2 print:border-0 print:pl-0">Infraestructura & DevOps</p>
				<div class="flex flex-wrap gap-2 print:hidden">
					<span class="skill-pill">Linux (Ubuntu/Mint)</span><span class="skill-pill">Windows 10/11</span><span class="skill-pill">Windows Server</span><span class="skill-pill">Redes TCP/IP</span><span class="skill-pill">DNS / DHCP</span><span class="skill-pill">VPN</span><span class="skill-pill">Putty (SSH)</span><span class="skill-pill">GLPI (ITSM)</span><span class="skill-pill">ITIL</span><span class="skill-pill">Soporte N1/N2</span><span class="skill-pill">Ferozo (Hosting)</span><span class="skill-pill">Hardware PC</span>
				</div>
				<p class="hidden print:block text-[9.5pt] text-black">Linux (Ubuntu/Mint/Debian), Windows 10/11, Windows Server, Redes TCP/IP, DNS, DHCP, VPN, SSH (Putty), Gestión de incidentes y requerimientos (GLPI / ITSM / ITIL), Soporte Help Desk N1/N2, Panel de hosting Ferozo, Mantenimiento y armado de hardware PC.</p>
			</div>
			
			<div class="fade-up print:mb-2">
				<p class="text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-3 print:text-black print:text-[10pt] print:mb-1 border-l-2 border-slate-700 pl-2 print:border-0 print:pl-0">Software & IA</p>
				<div class="flex flex-wrap gap-2 print:hidden">
					<span class="skill-pill">n8n Automation</span><span class="skill-pill">Agentes de IA / LLMs</span><span class="skill-pill">Python</span><span class="skill-pill">Bash Scripting</span><span class="skill-pill">APIs REST</span><span class="skill-pill">Webhooks</span><span class="skill-pill">SQL / SQLite</span><span class="skill-pill">PocketBase</span><span class="skill-pill">Git</span><span class="skill-pill">Inglés Técnico</span>
				</div>
				<p class="hidden print:block text-[9.5pt] text-black">Automatización de procesos con n8n, Agentes de IA / LLMs, Python, Bash Scripting, integración de APIs REST y Webhooks, SQL / SQLite (PocketBase), control de versiones con Git, Inglés Técnico (lectura y documentación).</p>
			</div>
		</section>

		<!-- FORMACIÓN ACADÉMICA -->
		<section id="formacion" class="py-14 mb-10 print:py-4 print:mb-0 print:border-0">
			<div class="fade-up mb-10 print:mb-3">
				<p class="text-xs font-bold uppercase tracking-[0.25em] text-indigo-400 mb-2 no-print">Educación</p>
				<h2 class="font-display text-3xl md:text-4xl font-bold text-white print:text-[14pt] print:border-b print:border-black print:pb-1 print:text-black uppercase">Formación Académica</h2>
			</div>
			<div class="fade-up grid md:grid-cols-2 gap-6 print:grid-cols-2 print:gap-4">
				
				<div class="p-6 md:p-8 rounded-2xl bg-[#0F172A]/50 border border-white/5 hover:border-blue-500 transition-colors backdrop-blur-sm print:bg-transparent print:border-0 print:p-0">
					<p class="font-display text-lg font-bold text-white leading-snug mb-1 print:text-black print:text-[10.5pt]">Tecnicatura Universitaria en Programación</p>
					<p class="text-slate-400 text-xs print:text-slate-800 print:text-[9pt]">Universidad Tecnológica Nacional (UTN)</p>
					<p class="text-blue-400 text-xs mt-2 uppercase tracking-widest font-bold print:text-slate-800 print:text-[8pt] print:mt-0">En curso</p>
				</div>
				
				<div class="p-6 md:p-8 rounded-2xl bg-[#0F172A]/50 border border-white/5 hover:border-blue-500 transition-colors backdrop-blur-sm print:bg-transparent print:border-0 print:p-0">
					<p class="font-display text-lg font-bold text-white leading-snug mb-1 print:text-black print:text-[10.5pt]">Programador Universitario</p>
					<p class="text-slate-400 text-xs print:text-slate-800 print:text-[9pt]">Universidad Nacional de Tucumán (UNT)</p>
					<p class="text-blue-400 text-xs mt-2 uppercase tracking-widest font-bold print:text-slate-800 print:text-[8pt] print:mt-0">En curso</p>
				</div>
			</div>
		</section>

	</main>

