---
import Layout from '../layouts/Layout.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { Image } from 'astro:assets';
import perfilImg from '../assets/foto.png';

const data = {
	name: "Franco Barrionuevo",
	title: "IT Support & Automation Engineer",
	location: "Carapachay, Buenos Aires, AR",
	phone: "+54 9 381 574-4776",
	phoneTel: "+5493815744776",
	email: "franmaxii@hotmail.com",
	cv: "francobarrionuevo.cv",
	cvUrl: "https://francobarrionuevo.cv",
	portfolio: "franmaxi.dev",
	portfolioUrl: "https://franmaxi.dev",
	github: "github.com/franmaxii",
	githubUrl: "https://github.com/franmaxii",
	linkedin: "linkedin.com/in/franco-maximiliano-barrionuevo",
	linkedinUrl: "https://www.linkedin.com/in/franco-maximiliano-barrionuevo/"
};
---

<Layout title={`${data.name} | Portfolio IT`}>
	<FloatingContact />
	
	<!-- NAV: Sticky -->
	<nav class="site-nav no-print fixed w-full z-50 bg-[#060B14]/60 backdrop-blur-xl border-b border-white/5">
		<div class="max-w-6xl mx-auto px-8 py-4 flex justify-between items-center">
			<a href="#perfil" class="font-display text-white font-bold text-lg tracking-tight">Franco<span class="text-blue-500">.</span></a>
			<div class="hidden md:flex items-center gap-8">
				<a href="#perfil" class="nav-link" data-nav>Perfil</a>
				<a href="#trayectoria" class="nav-link" data-nav>Experiencia</a>
				<a href="#competencias" class="nav-link" data-nav>Skills Tech</a>
				<a href="#formacion" class="nav-link" data-nav>Educación</a>
			</div>
		</div>
	</nav>

	<main class="max-w-6xl mx-auto px-8 pt-10 text-slate-300 print:text-black print:p-0 print:m-0 print:max-w-none">

		<!-- HERO SECTION -->
		<header id="perfil" class="relative pt-36 pb-20 print:pt-0 print:pb-4 print:border-b-2 print:border-black">

			<div class="flex flex-col md:flex-row items-start gap-10 print:flex-row print:gap-6 relative z-10">
				<!-- FOTO -->
				<div class="flex-shrink-0 relative group">
					<div class="absolute -inset-2 bg-blue-500/25 rounded-full blur-2xl opacity-60 group-hover:opacity-90 transition duration-500 no-print"></div>
					<div class="relative w-36 h-36 md:w-44 md:h-44 rounded-full overflow-hidden ring-1 ring-white/10 shadow-[0_10px_40px_-10px_rgba(59,130,246,0.35)] group-hover:ring-blue-500/40 transition print:ring-0 print:border print:border-slate-300 print:shadow-none print:w-28 print:h-28">
						<Image src={perfilImg} alt={data.name} class="w-full h-full object-cover" />
					</div>
				</div>
				
				<!-- TEXTO HERO -->
				<div class="flex-1 print:mt-2">
					<div class="fade-up inline-flex items-center gap-2.5 border border-blue-500/20 rounded-full px-4 py-1.5 mb-6 text-[11px] font-semibold uppercase tracking-[0.18em] text-blue-300 bg-blue-500/5 backdrop-blur-md print:hidden">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75 animate-ping"></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-blue-400"></span>
						</span>
						IT Support &amp; AI Automation
					</div>
					<h1 class="fade-up font-display text-5xl md:text-7xl font-bold text-white leading-[1.05] tracking-tight mb-2 print:text-3xl print:text-black">
						Franco <span class="text-blue-500 print:text-black">Barrionuevo</span>
					</h1>
					<div class="ornament-divider fade-up no-print" aria-hidden="true"><span></span><span></span></div>
					<h2 class="fade-up font-display text-base font-medium text-blue-300 uppercase tracking-[0.22em] mb-6 print:text-slate-800 print:text-[11pt] print:mt-1 print:mb-3">
						{data.title}
					</h2>
					<p class="fade-up text-sm leading-relaxed text-slate-400 max-w-2xl mb-8 print:text-black print:text-[10pt] print:mb-3">
						Profesional especializado en el <strong>Soporte de Infraestructura IT (Troubleshooting N1/N2)</strong> y la <strong>Automatización Inteligente de Procesos</strong>. Combino la administración de sistemas (Linux/Win, Servidores, GLPI) con el desarrollo de soluciones lógicas mediante <strong>n8n, Python y Agentes de IA</strong>. Mi enfoque es modernizar operaciones: reducir tareas manuales repetitivas, asegurar la red y resolver incidentes bajo SLAs corporativos exigentes.
					</p>
					
					<!-- DATOS CONTACTO -->
					<div class="fade-up flex flex-wrap gap-3 text-sm font-medium print:gap-1 print:flex-col print:text-[9.5pt]">
						<div class="flex gap-3 print:gap-6 print:mb-1">
							<a href={`mailto:${data.email}`} class="flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/5 rounded-md hover:bg-white/10 transition-all text-slate-300 print:text-black print:bg-transparent print:border-0 print:p-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 print:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>{data.email}
							</a>
							<a href={`tel:${data.phoneTel}`} class="flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/5 rounded-md hover:bg-white/10 transition-all text-slate-300 print:text-black print:bg-transparent print:border-0 print:p-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 print:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>{data.phone}
							</a>
							<span class="flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/5 rounded-md text-slate-300 print:text-black print:bg-transparent print:border-0 print:p-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 print:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>{data.location}
							</span>
						</div>
						
						<!-- ATS KEYWORDS IN PRINT: URLs explicitly written out for ATS parsers -->
						<div class="hidden print:flex flex-col gap-1 mt-1 text-[9pt] text-slate-700 font-medium">
							<span><strong>LinkedIn:</strong> {data.linkedin}</span>
							<span><strong>GitHub:</strong> {data.github}</span>
							<span><strong>Portfolio:</strong> {data.portfolio}</span>
							<span><strong>CV online:</strong> {data.cv}</span>
						</div>
					</div>
				</div>
			</div>
		</header>

		<!-- MÉTRICAS TECH -->
		<section class="fade-up py-10 print:hidden">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
				<div class="metric-card">
					<p class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-slate-500 mb-2">Automatización</p>
					<p class="font-display text-2xl font-semibold text-white">n8n / IA</p>
				</div>
				<div class="metric-card">
					<p class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-slate-500 mb-2">Tickets / ITSM</p>
					<p class="font-display text-2xl font-semibold text-white">GLPI</p>
				</div>
				<div class="metric-card">
					<p class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-slate-500 mb-2">Conexión Remota</p>
					<p class="font-display text-2xl font-semibold text-white">SSH / Putty</p>
				</div>
				<div class="metric-card">
					<p class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-slate-500 mb-2">Lenguajes</p>
					<p class="font-display text-2xl font-semibold text-white">Python</p>
				</div>
			</div>
		</section>

		<!-- EXPERIENCIA LABORAL -->
		<section id="trayectoria" class="py-14 print:py-4 print:border-0">
			<div class="fade-up mb-10 print:mb-3">
				<p class="section-kicker no-print">Trayectoria Profesional</p>
				<h2 class="font-display text-3xl md:text-4xl font-bold text-white print:text-[14pt] print:border-b print:border-black print:pb-1 print:text-black uppercase">Experiencia Laboral</h2>
			</div>
			
			<div class="space-y-6 print:space-y-4">
				
				<!-- Exp 1 -->
				<div class="fade-up exp-card rounded-2xl p-6 md:p-8 pl-7 md:pl-9 bg-[#0F172A]/50 border border-white/[0.06] relative backdrop-blur-sm print:bg-transparent print:border-0 print:p-0 print:pl-4 print:border-l-2 print:border-slate-400">
					<div class="absolute left-0 top-4 bottom-4 w-0.5 rounded-full bg-gradient-to-b from-blue-500 via-blue-500/40 to-transparent no-print"></div>
					<div class="flex flex-wrap justify-between items-start gap-4 mb-3">
						<div>
							<h3 class="font-display text-lg font-semibold text-white print:text-[11.5pt] print:text-black">Técnico de Sistemas & Infraestructura IT</h3>
							<p class="text-blue-300 font-medium text-sm mt-1 print:text-slate-700 print:italic">Empresa de Recupero Crediticio</p>
						</div>
						<span class="date-chip">Sept 2025 — Actualidad</span>
					</div>
					<ul class="space-y-2.5 text-sm text-slate-300/90 leading-relaxed print:text-[9.5pt] print:text-black print:space-y-1">
						<li class="flex gap-3"><span class="text-blue-500 flex-shrink-0 mt-1.5 h-1 w-1 rounded-full bg-current print:hidden"></span><span class="hidden print:inline">▸ </span><span><strong>Soporte Técnico N2 & Help Desk:</strong> Resolución de incidencias corporativas, diagnóstico de hardware/software y gestión de usuarios en plataformas de tickets (GLPI).</span></li>
						<li class="flex gap-3"><span class="text-blue-500 flex-shrink-0 mt-1.5 h-1 w-1 rounded-full bg-current print:hidden"></span><span class="hidden print:inline">▸ </span><span><strong>Administración de Redes y Servidores:</strong> Configuración de conexiones seguras (SSH mediante Putty), mantenimiento de la red local y asignación de permisos.</span></li>
						<li class="flex gap-3"><span class="text-blue-500 flex-shrink-0 mt-1.5 h-1 w-1 rounded-full bg-current print:hidden"></span><span class="hidden print:inline">▸ </span><span><strong>Infraestructura & Hardware:</strong> Ensamblaje, reparación, mantenimiento preventivo de PC y configuración de entornos de booteo (Dual-boot, BIOS/UEFI).</span></li>
					</ul>
				</div>

				<!-- Exp 2 -->
				<div class="fade-up exp-card rounded-2xl p-6 md:p-8 pl-7 md:pl-9 bg-[#0F172A]/50 border border-white/[0.06] relative backdrop-blur-sm print:bg-transparent print:border-0 print:p-0 print:pl-4 print:border-l-2 print:border-slate-400">
					<div class="absolute left-0 top-4 bottom-4 w-0.5 rounded-full bg-gradient-to-b from-blue-500 via-blue-500/40 to-transparent no-print"></div>
					<div class="flex flex-wrap justify-between items-start gap-4 mb-3">
						<div>
							<h3 class="font-display text-lg font-semibold text-white print:text-[11.5pt] print:text-black">Automation Engineer & IA</h3>
							<p class="text-blue-300 font-medium text-sm mt-1 print:text-slate-700 print:italic">Proyectos de Innovación Tecnológica</p>
						</div>
						<span class="date-chip">Ene 2026 — Actualidad</span>
					</div>
					<ul class="space-y-2.5 text-sm text-slate-300/90 leading-relaxed print:text-[9.5pt] print:text-black print:space-y-1">
						<li class="flex gap-3"><span class="text-blue-500 flex-shrink-0 mt-1.5 h-1 w-1 rounded-full bg-current print:hidden"></span><span class="hidden print:inline">▸ </span><span><strong>Desarrollo de Automatizaciones (n8n):</strong> Creación de flujos de trabajo (workflows) conectando APIs para optimizar procesos repetitivos y sincronizar datos empresariales.</span></li>
						<li class="flex gap-3"><span class="text-blue-500 flex-shrink-0 mt-1.5 h-1 w-1 rounded-full bg-current print:hidden"></span><span class="hidden print:inline">▸ </span><span><strong>Agentes de Inteligencia Artificial & Python:</strong> Integración de modelos de lenguaje (LLMs) y scripts en Python para potenciar bots de atención (Franmaxi-IA).</span></li>
						<li class="flex gap-3"><span class="text-blue-500 flex-shrink-0 mt-1.5 h-1 w-1 rounded-full bg-current print:hidden"></span><span class="hidden print:inline">▸ </span><span><strong>Bases de Datos & Hosting:</strong> Despliegue de bases de datos ágiles (PocketBase/SQLite) y administración de paneles de hosting (Ferozo).</span></li>
					</ul>
				</div>

				<!-- Exp 3 -->
				<div class="fade-up exp-card rounded-2xl p-6 md:p-8 pl-7 md:pl-9 bg-[#0F172A]/50 border border-white/[0.06] relative backdrop-blur-sm print:bg-transparent print:border-0 print:p-0 print:pl-4 print:border-l-2 print:border-slate-400">
					<div class="absolute left-0 top-4 bottom-4 w-0.5 rounded-full bg-gradient-to-b from-slate-500 via-slate-500/30 to-transparent no-print"></div>
					<div class="flex flex-wrap justify-between items-start gap-4 mb-3">
						<div>
							<h3 class="font-display text-lg font-semibold text-white print:text-[11.5pt] print:text-black">Soporte Técnico (N1) & Customer Service</h3>
							<p class="text-slate-400 font-medium text-sm mt-1 print:text-slate-700 print:italic">Customer Aegis</p>
						</div>
						<span class="date-chip">Jun 2020 — Dic 2022</span>
					</div>
					<ul class="space-y-2.5 text-sm text-slate-300/90 leading-relaxed print:text-[9.5pt] print:text-black print:space-y-1">
						<li class="flex gap-3"><span class="text-slate-500 flex-shrink-0 mt-1.5 h-1 w-1 rounded-full bg-current print:hidden"></span><span class="hidden print:inline">▸ </span><span><strong>Troubleshooting Remoto:</strong> Diagnóstico, triaje y resolución ágil de problemas reportados por usuarios finales.</span></li>
						<li class="flex gap-3"><span class="text-slate-500 flex-shrink-0 mt-1.5 h-1 w-1 rounded-full bg-current print:hidden"></span><span class="hidden print:inline">▸ </span><span><strong>Software CRM & SLAs:</strong> Actualización y seguimiento de incidencias en sistemas CRM, superando métricas de satisfacción (CSAT) y resolución.</span></li>
					</ul>
				</div>
			</div>
		</section>

		<!-- COMPETENCIAS TÉCNICAS -->
		<section id="competencias" class="py-14 print:py-4 print:border-0">
			<div class="fade-up mb-10 print:mb-3">
				<p class="section-kicker no-print">Stack Tecnológico</p>
				<h2 class="font-display text-3xl md:text-4xl font-bold text-white print:text-[14pt] print:border-b print:border-black print:pb-1 print:text-black uppercase">Skills Tech & Tools</h2>
			</div>
			
			<div class="fade-up grid md:grid-cols-2 gap-x-12 gap-y-6 mb-12 print:hidden">
				<div><div class="flex justify-between items-baseline text-[11px] tracking-wide mb-2"><span class="text-slate-300 font-medium">Troubleshooting Hardware & PC</span><span class="text-slate-500 font-semibold tabular-nums">95%</span></div><div class="h-[3px] bg-white/[0.06] rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full rounded-full bg-gradient-to-r from-blue-500 to-sky-400" style="--target-width:95%"></div></div></div>
				<div><div class="flex justify-between items-baseline text-[11px] tracking-wide mb-2"><span class="text-slate-300 font-medium">Linux Admin / Windows 11</span><span class="text-slate-500 font-semibold tabular-nums">90%</span></div><div class="h-[3px] bg-white/[0.06] rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full rounded-full bg-gradient-to-r from-blue-500 to-sky-400" style="--target-width:90%"></div></div></div>
				<div><div class="flex justify-between items-baseline text-[11px] tracking-wide mb-2"><span class="text-slate-300 font-medium">n8n / Agentes de IA</span><span class="text-slate-500 font-semibold tabular-nums">85%</span></div><div class="h-[3px] bg-white/[0.06] rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full rounded-full bg-gradient-to-r from-blue-500 to-sky-400" style="--target-width:85%"></div></div></div>
				<div><div class="flex justify-between items-baseline text-[11px] tracking-wide mb-2"><span class="text-slate-300 font-medium">Python / Bash Scripting</span><span class="text-slate-500 font-semibold tabular-nums">75%</span></div><div class="h-[3px] bg-white/[0.06] rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full rounded-full bg-gradient-to-r from-blue-500 to-sky-400" style="--target-width:75%"></div></div></div>
				<div><div class="flex justify-between items-baseline text-[11px] tracking-wide mb-2"><span class="text-slate-300 font-medium">Gestión TI (GLPI / SSH / Ferozo)</span><span class="text-slate-500 font-semibold tabular-nums">85%</span></div><div class="h-[3px] bg-white/[0.06] rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full rounded-full bg-gradient-to-r from-blue-500 to-sky-400" style="--target-width:85%"></div></div></div>
				<div><div class="flex justify-between items-baseline text-[11px] tracking-wide mb-2"><span class="text-slate-300 font-medium">Inglés (Lectura Técnica / IT)</span><span class="text-slate-500 font-semibold">Básico / Técnico</span></div><div class="h-[3px] bg-white/[0.06] rounded-full overflow-hidden" aria-hidden="true"><div class="skill-bar-fill h-full rounded-full bg-white/20" style="--target-width:55%"></div></div></div>
			</div>

			<div class="fade-up mb-6 print:mb-2">
				<p class="text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-3 print:text-black print:text-[10pt] print:mb-1 border-l-2 border-slate-700 pl-2 print:border-0 print:pl-0">Infraestructura & DevOps</p>
				<div class="flex flex-wrap gap-2 print:hidden">
					<span class="skill-pill">Linux (Ubuntu/Mint)</span><span class="skill-pill">Windows 10/11</span><span class="skill-pill">Windows Server</span><span class="skill-pill">Redes TCP/IP</span><span class="skill-pill">DNS / DHCP</span><span class="skill-pill">VPN</span><span class="skill-pill">Putty (SSH)</span><span class="skill-pill">GLPI (ITSM)</span><span class="skill-pill">ITIL</span><span class="skill-pill">Soporte N1/N2</span><span class="skill-pill">Ferozo (Hosting)</span><span class="skill-pill">Hardware PC</span>
				</div>
				<p class="hidden print:block text-[9.5pt] text-black">Linux (Ubuntu/Mint/Debian), Windows 10/11, Windows Server, Redes TCP/IP, DNS, DHCP, VPN, SSH (Putty), Gestión de incidentes y requerimientos (GLPI / ITSM / ITIL), Soporte Help Desk N1/N2, Panel de hosting Ferozo, Mantenimiento y armado de hardware PC.</p>
			</div>
			
			<div class="fade-up print:mb-2">
				<p class="text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-3 print:text-black print:text-[10pt] print:mb-1 border-l-2 border-slate-700 pl-2 print:border-0 print:pl-0">Software & IA</p>
				<div class="flex flex-wrap gap-2 print:hidden">
					<span class="skill-pill">n8n Automation</span><span class="skill-pill">Agentes de IA / LLMs</span><span class="skill-pill">Python</span><span class="skill-pill">Bash Scripting</span><span class="skill-pill">APIs REST</span><span class="skill-pill">Webhooks</span><span class="skill-pill">SQL / SQLite</span><span class="skill-pill">PocketBase</span><span class="skill-pill">Git</span><span class="skill-pill">Inglés Técnico</span>
				</div>
				<p class="hidden print:block text-[9.5pt] text-black">Automatización de procesos con n8n, Agentes de IA / LLMs, Python, Bash Scripting, integración de APIs REST y Webhooks, SQL / SQLite (PocketBase), control de versiones con Git, Inglés Técnico (lectura y documentación).</p>
			</div>
		</section>

		<!-- FORMACIÓN ACADÉMICA -->
		<section id="formacion" class="py-14 mb-10 print:py-4 print:mb-0 print:border-0">
			<div class="fade-up mb-10 print:mb-3">
				<p class="section-kicker no-print">Educación</p>
				<h2 class="font-display text-3xl md:text-4xl font-bold text-white print:text-[14pt] print:border-b print:border-black print:pb-1 print:text-black uppercase">Formación Académica</h2>
			</div>
			<div class="fade-up grid md:grid-cols-2 gap-6 print:grid-cols-2 print:gap-4">
				
				<div class="p-6 md:p-7 rounded-2xl bg-[#0F172A]/50 border border-white/[0.06] hover:border-blue-500/40 hover:bg-blue-500/[0.04] transition-colors backdrop-blur-sm print:bg-transparent print:border-0 print:p-0">
					<p class="font-display text-base font-semibold text-white leading-snug mb-1.5 print:text-black print:text-[10.5pt]">Tecnicatura Universitaria en Programación</p>
					<p class="text-slate-400 text-xs print:text-slate-800 print:text-[9pt]">Universidad Tecnológica Nacional (UTN)</p>
					<p class="inline-block text-blue-300 text-[10px] mt-3 uppercase tracking-[0.18em] font-semibold border border-blue-500/20 rounded-full px-2.5 py-1 print:border-0 print:p-0 print:text-slate-800 print:text-[8pt] print:mt-0">En curso</p>
				</div>

				<div class="p-6 md:p-7 rounded-2xl bg-[#0F172A]/50 border border-white/[0.06] hover:border-blue-500/40 hover:bg-blue-500/[0.04] transition-colors backdrop-blur-sm print:bg-transparent print:border-0 print:p-0">
					<p class="font-display text-base font-semibold text-white leading-snug mb-1.5 print:text-black print:text-[10.5pt]">Programador Universitario</p>
